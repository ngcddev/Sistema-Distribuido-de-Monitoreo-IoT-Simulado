# Copiar a .env (cp .env.example .env) y ajustar los valores.
# Con DB_USER=root, DB_PASSWORD debe ser igual a MYSQL_ROOT_PASSWORD.
MYSQL_ROOT_PASSWORD=root
DB_USER=root
DB_PASSWORD=root
DB_PORT=3306
INTERVALO_SEGUNDOS=5

# Tolerancia a fallos (segundos, salvo CB_MAX_FAILS)
# MEDICIONES_TIMEOUT / SENSORES_TIMEOUT: tiempo máximo de espera de Monitoreo hacia cada servicio.
# GATEWAY_TIMEOUT: tiempo máximo del Gateway hacia cualquier servicio (debe ser mayor que los anteriores).
MEDICIONES_TIMEOUT=3
SENSORES_TIMEOUT=2
GATEWAY_TIMEOUT=15
# Circuit Breaker de Monitoreo:
# CB_MAX_FAILS: fallas técnicas seguidas antes de abrir el circuito (OPEN).
# CB_TIMEOUT: segundos en OPEN antes de permitir una solicitud de prueba (HALF_OPEN).
CB_MAX_FAILS=3
CB_TIMEOUT=10
