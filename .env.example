# Copiar a .env (cp .env.example .env) y cambiar las contraseñas.
# DB_USER no puede ser "root": MySQL crea este usuario con permisos solo sobre la base de cada servicio.
# Estas variables solo se aplican al crear los volúmenes; si ya existen, ver "Cambiar credenciales" en el README.
MYSQL_ROOT_PASSWORD=cambiar-root
DB_USER=agrosense
DB_PASSWORD=cambiar-password

# Administración del Home: Nginx pide este usuario y contraseña para crear, modificar y borrar datos
# (consultar es libre). Viajan sin cifrar por HTTP: úsalas solo en local o detrás de HTTPS.
HOME_ADMIN_USER=admin
HOME_ADMIN_PASSWORD=cambiar-admin

INTERVALO_SEGUNDOS=5
INTERVALO_EVALUACION_SEGUNDOS=10

# Días que se conservan lecturas y alertas; lo más antiguo se borra cada hora (0 = no borrar nada).
RETENCION_DIAS=30
