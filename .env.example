# Copiar a .env (cp .env.example .env) y ajustar los valores.
# Con DB_USER=root, DB_PASSWORD debe ser igual a MYSQL_ROOT_PASSWORD.
MYSQL_ROOT_PASSWORD=root
DB_USER=root
DB_PASSWORD=root
DB_PORT=3306
INTERVALO_SEGUNDOS=5

# URLs de los servicios (nombre del contenedor en la red de Docker)
MEDICIONES_URL=http://mediciones:5001
SENSORES_URL=http://sensores:5003

# URLs que usa el API Gateway para reenviar peticiones
SENSOR_SERVICE_URL=http://sensores:5003
MONITOREO_SERVICE_URL=http://monitoreo:5002
MEDICIONES_SERVICE_URL=http://mediciones:5001

# Timeouts para llamadas entre servicios (en segundos)
MEDICIONES_TIMEOUT=3
SENSORES_TIMEOUT=2

# Configuración de Circuit Breaker
# CB_MAX_FAILS: fallos seguidos antes de abrir el circuito
# CB_TIMEOUT: segundos en open antes de permitir una prueba (half-open)
CB_MAX_FAILS=3
CB_TIMEOUT=10
