              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Responde JSON', function () { pm.response.to.be.json; });",
                  "const c = pm.response.json();",
                  "console.log('mediciones:', c.mediciones.estado, 'fallos:', c.mediciones.contador_fallos);",
                  "pm.test('Estado válido', function () { pm.expect(['CLOSED','OPEN','HALF_OPEN']).to.include(c.mediciones.estado); });"
                ]
              }
            }
          ],
          "request": {
