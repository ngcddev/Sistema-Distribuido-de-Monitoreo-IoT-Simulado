        {
          "name": "Health (Gateway y servicios)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Responde JSON', function () { pm.response.to.be.json; });",
                  "pm.test('Todos los servicios ok', function () {",
                  "  const s = pm.response.json().servicios;",
                  "  pm.expect(s.sensores).to.eql('ok'); pm.expect(s.mediciones).to.eql('ok'); pm.expect(s.monitoreo).to.eql('ok');",
                  "});"
                ]
